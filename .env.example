AUTH_SECRET=replace-with-openssl-rand-base64-32
# Optional override for encrypting BYOK API keys. Falls back to AUTH_SECRET.
# CREDENTIALS_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Production (rebuild after changing NEXT_PUBLIC_*):
# AUTH_URL=https://clusterdeck.space
# NEXT_PUBLIC_APP_URL=https://clusterdeck.space
# NEXT_PUBLIC_REALTIME_URL=wss://clusterdeck.space/realtime

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

REALTIME_SECRET=replace-with-openssl-rand-base64-32
REALTIME_PORT=1234
MCP_PORT=1235
# Public URL shown in the token form. Empty means the site origin + /mcp.
# MCP_PUBLIC_URL=https://clusterdeck.space/mcp
# Where the web app proxies /mcp. Docker Compose sets this to the realtime service.
# MCP_UPSTREAM_URL=http://127.0.0.1:1235/mcp
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1234
NEXT_PUBLIC_APP_URL=http://localhost:3000

WEB_PORT=3000

RESEND_API_KEY=
EMAIL_FROM=ClusterDeck <noreply@clusterdeck.space>
# Forward inbound mail on your domain to your personal inbox (Resend Receiving + webhook)
EMAIL_FORWARD_TO=
EMAIL_INBOUND_FROM=ClusterDeck <inbox@clusterdeck.space>
