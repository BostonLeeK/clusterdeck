{
  "name": "dataflow",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter realtime --filter health-runner dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @dataflow/db generate",
    "db:migrate": "pnpm --filter @dataflow/db migrate",
    "db:seed": "pnpm --filter @dataflow/db seed",
    "db:wipe-users": "pnpm --filter @dataflow/db wipe-users",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d --build"
  },
  "devDependencies": {
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.7",
    "typescript": "^5.9.3"
  }
}
